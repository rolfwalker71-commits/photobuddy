# Öffentliche App-URL (ohne Slash am Ende).
# Lokal so lassen. Auf dem Server die URL, unter der Photobuddy erreichbar ist
# (Handy im WLAN: http://192.168.x.x:3388).
NEXT_PUBLIC_SITE_URL=http://localhost:3388

# Öffentliche Supabase-API = Kong. Lokal so lassen (Port 8000).
# Wenn leer, wird der Host aus SITE_URL genommen und Port 8000 angehängt.
# Handy im WLAN: http://192.168.x.x:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# --- optional ---
# KONG_HTTP_PORT=8000
# ADDITIONAL_REDIRECT_URLS=
# PORT=3388
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Secrets legt `npm run setup` bzw. Docker beim ersten Start an.
# Nicht nötig zum Ausfüllen. service_role nie als NEXT_PUBLIC_* setzen.
# JWT_SECRET=
# ANON_KEY=
# SERVICE_ROLE_KEY=
# POSTGRES_PASSWORD=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
