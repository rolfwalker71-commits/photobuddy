# Öffentliche App-URL (ohne Slash am Ende).
# Lokal so lassen. Server: URL, unter der Photobuddy erreichbar ist
# (Handy im WLAN: http://192.168.x.x:3388).
NEXT_PUBLIC_SITE_URL=http://localhost:3388
PORT=3388

# Erster Login. Passwort nach dem Start ändern.
ADMIN_EMAIL=admin@photobuddy.local
ADMIN_PASSWORD=admin

# Secrets legt `npm run setup` an (nicht überschreiben, wenn schon gesetzt).
# AUTH_SECRET=
# POSTGRES_PASSWORD=
#
# Compose-Container: immer Hostname db (kein Host-Port 5432).
# DATABASE_URL=postgres://photobuddy:…@db:5432/photobuddy
#
# Lokal `npm run dev` — erst Overlay, dann Host-Port 5433:
#   docker compose -f docker-compose.yml -f docker-compose.host-db.yml up -d db
# DATABASE_URL=postgres://photobuddy:…@127.0.0.1:5433/photobuddy

# --- optional ---
# PHOTOS_DIR=./data/photos
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
