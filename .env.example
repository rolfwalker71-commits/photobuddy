# Öffentliche App-URL (ohne Slash am Ende).
# Lokal so lassen. Auf dem Server die URL, unter der Photobuddy erreichbar ist
# (Handy im WLAN: http://192.168.x.x:3388).
NEXT_PUBLIC_SITE_URL=http://localhost:3388

# --- optional ---
# PORT=3388
# PHOTOS_DIR=./data/photos
# DATABASE_URL=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Secrets legt `npm run setup` bzw. Docker beim ersten Start an.
# AUTH_SECRET=
# POSTGRES_PASSWORD=
